<!doctype html>
<html lang="en">
<head>
     <meta charset="UTF-8">
     <meta name="viewport" 
           content="width=device-width, 
           user-scalable=no, 
           initial-scale=1.0, 
           maximum-scale=1.0, 
           minimum-scale=1.0">
     <meta http-equiv="X-UA-Compatible" 
           content="ie=edge">
     <title>{{title}}</title>
     <link rel="stylesheet" href="style.css">
</head>
<body>
<h1>{{title}}</h1>
    {{ content | safe }}

  <is-land on:visible type="petite-vue">
    <div v-scope="{ count: 0 }">
      <p>Count: <span v-text="count"></span></p>
      <button @click="count++">Increment</button>
    </div>
  </is-land>  
    
</body>
</html>